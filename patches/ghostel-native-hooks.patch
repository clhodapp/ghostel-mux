+/// Create a terminal whose state comes from a libghostty snapshot.
+///
+/// The snapshot supplies the grid, history, modes, colors, title and working
+/// directory.  Its VT parser must have been at ground when it was taken.
+/// Kitty image state is not part of a snapshot, so the image limits come
+/// from OPTS like those of a new terminal.
+pub fn initFromSnapshot(
+    alloc: Allocator,
+    io: std.Io,
+    env: emacs.Env,
+    snapshot: []const u8,
+    opts: gt.Terminal.Options,
+) !*Self {
+    var reader: std.Io.Reader = .fixed(snapshot);
+    var decoded = try gt.snapshot.decodeExact(alloc, io, &reader, .{
+        .max_continuation_bytes = 0,
+    });
+    defer decoded.deinit(alloc);
+
+    var terminal = decoded.toOwned();
+    errdefer terminal.deinit(alloc);
+    var screens = terminal.screens.all.iterator();
+    while (screens.next()) |entry| {
+        const screen = entry.value.*;
+        screen.kitty_images.setLimit(io, alloc, screen, opts.kitty_image_storage_limit);
+        screen.kitty_images.image_limits = opts.kitty_image_loading_limits;
+    }
+    return initWithTerminal(alloc, io, env, terminal);
+}
+
