+pub fn connectNativeSocket(
+    self: *Self,
+    path: [:0]const u8,
+    replica_name: [:0]const u8,
+    event_fd: ChannelFd,
+) !void {
+    if (self.process != null) return error.ProcessAlreadyAttached;
+
+    const initial_size = blk: {
+        try self.lock();
+        defer self.unlock();
+        break :blk self.winSize();
+    };
+
+    var no_env: std.process.Environ.Map = .init(self.alloc);
+    defer no_env.deinit();
+    const process = try self.alloc.create(NativeProcess);
+    errdefer self.alloc.destroy(process);
+    try process.init(
+        self.alloc,
+        self.io,
+        initial_size,
+        ProcessParams{
+            .file = "",
+            .args = &.{},
+            .env = &no_env,
+            .socket = .{ .path = path, .replica_name = replica_name },
+        },
+        self,
+        event_fd,
+    );
+    self.process = process;
+    self.pty_size = initial_size;
+}
