+/// Like `writeWithRetry', but a socket whose peer has gone reports EPIPE
+/// instead of raising SIGPIPE in whichever thread wrote.
+fn sendWithRetry(fd: sys.fd_t, data: []const u8) isize {
+    // From the std.posix definitions of Zig: MSG_NOSIGNAL in glibc is a macro
+    // naming an enum constant, which translated C does not carry.
+    const flags: c_int = if (@hasDecl(std.posix.MSG, "NOSIGNAL")) std.posix.MSG.NOSIGNAL else 0;
+    while (true) {
+        const written = c.send(fd, data.ptr, data.len, flags);
+        if (sys.errno(written) != .INTR) return written;
+    }
+}
+
+fn isSocket(self: *const Self) bool {
+    return self.pid == -1;
+}
+
+fn initSocket(params: backend_types.SocketParams) !Self {
+    var self = Self{ .pty = .{} };
+    errdefer self.pty.deinit();
+
+    if (params.replica_name.len >= self.pty.replica_name.len) return error.NameTooLong;
+    @memcpy(self.pty.replica_name[0..params.replica_name.len], params.replica_name);
+    self.pty.replica_name[params.replica_name.len] = 0;
+
+    var addr = std.mem.zeroes(c.struct_sockaddr_un);
+    addr.sun_family = c.AF_UNIX;
+    if (params.path.len >= addr.sun_path.len) return error.NameTooLong;
+    @memcpy(addr.sun_path[0..params.path.len], params.path);
+
+    self.pty.primary_fd = c.socket(c.AF_UNIX, c.SOCK_STREAM, 0);
+    if (self.pty.primary_fd < 0) return error.SocketFailed;
+    _ = try fcntl(self.pty.primary_fd, sys.F.SETFD, sys.FD_CLOEXEC);
+    if (@hasDecl(c, "SO_NOSIGPIPE")) {
+        const one: c_int = 1;
+        if (c.setsockopt(self.pty.primary_fd, c.SOL_SOCKET, c.SO_NOSIGPIPE, &one, @sizeOf(c_int)) != 0) {
+            return error.SetSockOptFailed;
+        }
+    }
+    while (true) {
+        // Zig's binding, because glibc declares the address argument as a
+        // transparent union that translated C cannot pass a pointer to.
+        const rc = sys.connect(
+            self.pty.primary_fd,
+            @ptrCast(&addr),
+            @sizeOf(c.struct_sockaddr_un),
+        );
+        switch (sys.errno(rc)) {
+            .SUCCESS => break,
+            .INTR => continue,
+            else => return error.ConnectFailed,
+        }
+    }
+
+    if (sys.errno(sys.pipe(&self.wake_pipe)) != .SUCCESS) {
+        return error.PipeCreationFailed;
+    }
+    errdefer {
+        _ = sys.close(self.wake_pipe[0]);
+        _ = sys.close(self.wake_pipe[1]);
+    }
+    for (self.wake_pipe) |fd| {
+        _ = try fcntl(fd, sys.F.SETFD, sys.FD_CLOEXEC);
+    }
+
+    const flags = try fcntl(self.pty.primary_fd, sys.F.GETFL, 0);
+    _ = try fcntl(
+        self.pty.primary_fd,
+        sys.F.SETFL,
+        flags | @as(u32, @bitCast(sys.O{ .NONBLOCK = true })),
+    );
+    return self;
+}
